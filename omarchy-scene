#!/usr/bin/env bash
#
# omarchy-scene - Scene-based omarchy plugin set switcher
#
# Switch omarchy plugin sets by occasion (scene):
#   - default is the base set: its plugins stay enabled in every scene
#   - every scene runs default + locked (inherited, always on) + its own plugins
#   - plugins in no scene are unmanaged and never touched
#   - omarchy built-ins follow the system state and are locked by default
#
# Mechanism: atomically rewrite ~/.config/omarchy/shell.json (shell hot-reloads) and cache each
# managed plugin's full entry (position + settings), restoring it exactly on re-enable.
#
# Usage:
#   omarchy-scene list                list all scenes and plugin membership
#   omarchy-scene current             print the current scene
#   omarchy-scene set <scene> [--dry-run]   switch to a scene
#   omarchy-scene apply <scene> --on <ids> --off <ids>   apply marked toggles + switch
#   omarchy-scene cycle [--dry-run]   cycle to the next scene (keybind-friendly)
#   omarchy-scene init [--force]      bootstrap config from currently enabled plugins
#   omarchy-scene add <name> [--label <label>]   create a scene
#   omarchy-scene rm <name>           delete a scene
#   omarchy-scene add-plugin <scene> <plugin-id>  add a plugin to a scene
#   omarchy-scene rm-plugin <scene> <plugin-id>   remove a plugin from a scene
#   omarchy-scene refresh [--no-reopen]  re-snapshot all managed plugin entries
#                                     (--no-reopen: just refresh, don't auto-reopen the config panel)
#   omarchy-scene menu-add            write the Scenes submenu into omarchy-menu.jsonc
#   omarchy-scene menu-remove         remove the Scenes submenu
#   omarchy-scene edit                open scenes.json with $EDITOR (revalidates + refreshes the panel)
#   omarchy-scene reopen-done         clear the .reopen-config marker (QML-internal; unlink, never follows)
#   omarchy-scene label <scene> <label>   rename a scene's display name
#   omarchy-scene icon <scene> <glyph>     set a scene's bar icon (empty glyph clears)
#   omarchy-scene rename <old> <new>      rename a scene (key; keeps its label)
#   omarchy-scene status              per-plugin: current vs target state
#
# Config:
#   ~/.config/omarchy/scenes/scenes.json   scene definitions (user-editable)
#   ~/.config/omarchy/scenes/entries.json  managed plugin entry cache (auto-maintained)
#
# Security model (descriptor-bound I/O; no check-then-open anywhere):
#   * Every read opens the path ONCE via openat(2) walking each component with O_NOFOLLOW
#     (O_DIRECTORY on intermediates), then fstat(2)-validates: regular file, owned by the
#     current user, size <= 8 MiB.  The validated content is captured from that descriptor
#     and later tools (jq/awk/grep/sed) only ever see the captured bytes via stdin — the
#     mutable pathname is never reopened.
#   * FIFOs/devices are refused (O_NONBLOCK open + S_ISREG fstat) so hostile named pipes
#     can never block the CLI.
#   * Every write creates a random temp file in the SAME directory with O_CREAT|O_EXCL and
#     keeps its descriptor open for the whole create -> write -> fstat validate -> fchmod ->
#     fsync -> atomic publish (rename via the bound parent dir_fd) sequence.  The temp
#     pathname is never reopened for cat/stat/chmod/sync by any path-based command.
#   * Backups copy descriptor-to-descriptor into a random O_EXCL name in the same directory
#     (timestamp + random suffix) — no predictable path, no collision.
#   * The mutex lock file is opened atomically (O_CREAT + O_NOFOLLOW) and flock(1)-locked
#     by a helper process that dies with its parent (PR_SET_PDEATHSIG), so a crashed CLI
#     can never leave a stale lock.
#   * Structural limits are enforced on the validated bytes BEFORE anything is emitted to
#     the QML panel (see MAX_* in the embedded secure I/O core):
#        - byte limit: 8 MiB (kept), JSON depth <= 32, string <= 4096 chars,
#          array/object member count <= 65536 (generic)
#        - scenes.json: at most 12 scenes, scene keys <= 10 chars [a-zA-Z0-9_-], labels <= 64 chars,
#          icons <= 4 chars, plugin lists <= 256 entries, plugin ids
#          ^[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}$; _layouts.<scene> full-layout snapshots are
#          validated with the same caps. Layout snapshots let scene switches restore the
#          exact previous bar arrangement, so unmanaged built-in widgets (wifi/ai/audio/...)
#          are never displaced by index drift.
#        - entries.json: <= 4096 records, keys are plugin ids
#   * Backups auto-prune in-place: each backup keeps only the newest
#     $OMARCHY_SCENES_BACKUPS (default 10) of its own <file>.bak.* files; files
#     belonging to other tools (e.g. shell.json.bak.opencode.*) are never touched.
#        - catalog-derived fields (fed to QML): name <= 128, id <= 64, kinds <= 16 x 32
#        - menu command/action lengths are bounded by the scene-key limit (<= 10 chars)
#   * The .reopen-config marker is part of the same core: written with op_write (O_EXCL temp in the
#     marker dir + descriptor-relative atomic rename) and cleared by plain unlink (rm(1) removes the
#     link itself and never follows or truncates a pre-placed symlink target). The QML clears it via
#     `omarchy-scene reopen-done`, never through shell redirection.
#   * Requires python3 (stdlib only) for the O_NOFOLLOW/O_NONBLOCK openat machinery that
#     bash redirection cannot express.
#
set -euo pipefail

CONFIG_DIR="${OMARCHY_SCENES_DIR:-$HOME/.config/omarchy/scenes}"
SCENES_FILE="$CONFIG_DIR/scenes.json"
ENTRIES_FILE="$CONFIG_DIR/entries.json"
UI_STATE_FILE="$CONFIG_DIR/ui-state.json"
SHELL_JSON="$HOME/.config/omarchy/shell.json"
MENU_FILE="$HOME/.config/omarchy/extensions/omarchy-menu.jsonc"
MENU_MARK_BEGIN="// BEGIN omarchy-scene (auto-generated; omarchy-scene menu-add/refresh manage this block)"
MENU_MARK_END="// END omarchy-scene"
SHELL_RELOAD_CMD="omarchy-shell -q shell reloadConfig"

# 管理上限（cmd_add 等命令在写入前本地强制）
MAX_SCENES=5
MAX_NAME_LEN=10                   # 场景名 key（进入菜单命令/检查字符串，必须小而严格）
MAX_LABEL_LEN=64                  # 场景显示名 label（显示字段，容忍较长文案）

# ---------------------------------------------------------------- helpers

die() { echo "omarchy-scene: $*" >&2; exit 1; }

ensure_config_dir() { mkdir -p "$CONFIG_DIR"; }

# ---------------------------------------------------------------- 安全 I/O 核心（描述符绑定）

PY_BIN=$(command -v python3) || die "python3 is required (please install python3)"

# 描述符绑定安全 I/O。所有操作都在 python 里通过 openat + O_NOFOLLOW 完成：
#   read <type> <path>            读取（type: raw|json|scenes|entries），通过校验的内容输出到 stdout
#   read-maybe <type> <path>      同上，但文件不存在时退出码 3（不报错）
#   write <path>                  从 fd 3 读内容 -> 同目录 O_EXCL 临时文件 -> fd 写/校验/fchmod/fsync -> 原子 rename
#   backup <path>                 描述符到描述符备份到同目录随机名（时间戳+随机后缀）
#   lock <lockpath> <statuspath>  O_NOFOLLOW 打开 + flock(EX|NB)；写握手状态文件；持有锁直到父进程死亡
# 注意: 调用者的 stdin（fd 0）被 heredoc 占据（python 脚本本体），因此 write 的内容从 fd 3 读取。
secure_io() {
  # fd 3 = 调用者 stdin（write 操作的数据通道）；fd 0 交给解释器读取脚本（heredoc）
  exec 3<&0
  "$PY_BIN" - "$@" <<'OMARCHY_SCENE_PY_IO'
import ctypes, errno, fcntl, json, os, re, secrets, signal, stat, sys, time

# ---- 结构上限（安全审查要求；在输出到 QML 之前强制）----
MAX_BYTES      = 8 * 1024 * 1024   # 单文件字节上限（保留 8 MiB）
MAX_DEPTH      = 32                # JSON 嵌套深度上限
MAX_STR        = 4096              # 通用字符串长度上限（字符）
MAX_ITEMS      = 65536             # 通用数组/对象成员数上限
MAX_WRITE      = 32 * 1024 * 1024  # 写内容上限（防御性；写入内容均来自本脚本内部管道）
MAX_SCENES_DOC = 12                # scenes.json 自定义场景数上限（管理上限 5 + 余量）
MAX_LIST       = 256               # scenes.json 各插件列表长度上限
MAX_LABEL_LEN  = 64                # 场景显示名（label）上限（显示字段，放宽到 64；场景名 key 仍 <=10）
MAX_ENTRIES    = 4096              # entries.json 记录数上限
NAME_RE = re.compile(r"^[A-Za-z0-9_\-]{1,10}$")
ID_RE   = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._\-]{0,63}$")

def fail(msg):
    sys.stderr.write("omarchy-scene: %s\n" % msg)
    sys.exit(1)

def resolve_parent(path):
    """将路径逐组件用 openat + O_NOFOLLOW 解析（无 check-then-open）。
       返回 (父目录fd, 末组件名, 绝对路径)。任一组件是符号链接/非目录即失败。"""
    ap = os.path.abspath(path)
    comps = ap.split("/")
    base = comps[-1]
    if base == "":
        fail("refusing empty path: %s" % path)
    fd = None
    try:
        fd = os.open("/", os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
        for c in comps[1:-1]:
            if c in ("", "."):
                continue
            if c == "..":
                fail("refusing '..' in path: %s" % path)
            nfd = os.open(c, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC, dir_fd=fd)
            os.close(fd)
            fd = nfd
    except OSError as e:
        if fd is not None:
            os.close(fd)
        fail("cannot open %s: %s" % (os.path.dirname(ap) or "/", e.strerror or e))
    return fd, base, ap

def open_final(path, flags, mode=0):
    """打开末组件（含 O_NOFOLLOW）。返回 (fd, 父目录fd, base, 绝对路径)。"""
    pfd, base, ap = resolve_parent(path)
    try:
        nfd = os.open(base, flags | os.O_NOFOLLOW | os.O_CLOEXEC, mode, dir_fd=pfd)
    except OSError:
        os.close(pfd)
        raise
    return nfd, pfd, base, ap

def scan_depth_ok(text):
    """扫描 JSON 文本（跳过字符串字面量）求括号深度，超限即拒。"""
    depth = 0
    i = 0
    n = len(text)
    while i < n:
        c = text[i]
        if c == '"':
            i += 1
            while i < n:
                ch = text[i]
                if ch == "\\":
                    i += 2
                    continue
                if ch == '"':
                    break
                i += 1
            i += 1
            continue
        if c in "[{":
            depth += 1
            if depth > MAX_DEPTH:
                return False
        elif c in "]}":
            depth -= 1
        i += 1
    return True

def walk_check(obj, path):
    """通用结构上限：数组/对象长度、字符串/键长度。"""
    if isinstance(obj, dict):
        if len(obj) > MAX_ITEMS:
            fail("%s: object has too many members (%d)" % (path, len(obj)))
        for k, v in obj.items():
            if len(k) > MAX_STR:
                fail("%s: member name too long (%d chars)" % (path, len(k)))
            walk_check(v, path)
    elif isinstance(obj, list):
        if len(obj) > MAX_ITEMS:
            fail("%s: array too long (%d entries)" % (path, len(obj)))
        for v in obj:
            walk_check(v, path)
    elif isinstance(obj, str):
        if len(obj) > MAX_STR:
            fail("%s: string too long (%d chars)" % (path, len(obj)))

def parse_checked(data, path):
    try:
        text = data.decode("utf-8")
    except UnicodeDecodeError:
        fail("%s: not valid UTF-8" % path)
    if not scan_depth_ok(text):
        fail("%s: JSON nesting deeper than %d" % (path, MAX_DEPTH))
    try:
        doc = json.loads(text)
    except ValueError as e:
        fail("%s: invalid JSON (%s)" % (path, e))
    walk_check(doc, path)
    return doc

def check_scenes(doc, path):
    """scenes.json 专属结构上限（含全部用户可见字段）。"""
    if not isinstance(doc, dict):
        fail("%s: scenes.json must be a JSON object" % path)
    if doc.get("version") != 1:
        fail("%s: invalid scenes.json (version must be 1)" % path)
    cur = doc.get("current", "default")
    if not isinstance(cur, str) or not NAME_RE.match(cur):
        fail("%s: invalid .current (scene names: a-zA-Z0-9_- <=10 chars)" % path)
    scenes = doc.get("scenes", {})
    if not isinstance(scenes, dict) or len(scenes) > MAX_SCENES_DOC:
        fail("%s: invalid .scenes (object with at most %d scenes)" % (path, MAX_SCENES_DOC))
    if cur != "default" and cur not in scenes:
        fail("%s: .current references unknown scene %r" % (path, cur))
    if "defaultIcon" in doc and (not isinstance(doc["defaultIcon"], str) or len(doc["defaultIcon"]) > 4):
        fail("%s: defaultIcon too long (max 4)" % path)
    for key in ("default", "locked", "unlockedBuiltins"):
        v = doc.get(key, [])
        if not isinstance(v, list) or len(v) > MAX_LIST:
            fail("%s: .%s must be an array of at most %d plugin ids" % (path, key, MAX_LIST))
        for x in v:
            if not isinstance(x, str) or not ID_RE.match(x):
                fail("%s: invalid plugin id in .%s: %r (max 64 chars [A-Za-z0-9._-])" % (path, key, x))
    for name, sc in scenes.items():
        if not NAME_RE.match(name):
            fail("%s: invalid scene name %r (a-zA-Z0-9_- <=10 chars)" % (path, name))
        if not isinstance(sc, dict):
            fail("%s: scene %r must be an object" % (path, name))
        if "label" in sc and (not isinstance(sc["label"], str) or len(sc["label"]) > MAX_LABEL_LEN):
            fail("%s: scene %r label too long (max %d)" % (path, name, MAX_LABEL_LEN))
        if "icon" in sc and (not isinstance(sc["icon"], str) or len(sc["icon"]) > 4):
            fail("%s: scene %r icon too long (max 4)" % (path, name))
        plugs = sc.get("plugins", [])
        if not isinstance(plugs, list) or len(plugs) > MAX_LIST:
            fail("%s: scene %r plugins must be an array of at most %d ids" % (path, name, MAX_LIST))
        for x in plugs:
            if not isinstance(x, str) or not ID_RE.match(x):
                fail("%s: invalid plugin id in scene %r: %r" % (path, name, x))
    if "_layouts" in doc:
        # 场景布局快照（_layouts.<scene> = {left,center,right} 部件数组）——内部记忆字段，同样受限
        lays = doc["_layouts"]
        if not isinstance(lays, dict) or len(lays) > MAX_SCENES_DOC + 1:
            fail("%s: _layouts must be an object with at most %d scenes" % (path, MAX_SCENES_DOC + 1))
        for sname, secs in lays.items():
            if not NAME_RE.match(sname):
                fail("%s: invalid _layouts scene key %r" % (path, sname))
            if not isinstance(secs, dict):
                fail("%s: _layouts[%r] must be an object" % (path, sname))
            for sect in ("left", "center", "right"):
                arr = secs.get(sect, [])
                if not isinstance(arr, list) or len(arr) > MAX_LIST:
                    fail("%s: _layouts[%r].%s invalid (array <= %d)" % (path, sname, sect, MAX_LIST))
                for w in arr:
                    if not isinstance(w, dict):
                        fail("%s: _layouts[%r].%s entry must be an object" % (path, sname, sect))
                    wid = w.get("id")
                    if not isinstance(wid, str) or len(wid) > 64:
                        fail("%s: _layouts[%r].%s widget id invalid" % (path, sname, sect))

def check_entries(doc, path):
    if not isinstance(doc, dict) or len(doc) > MAX_ENTRIES:
        fail("%s: entries.json must be an object with at most %d records" % (path, MAX_ENTRIES))
    for k in doc:
        if len(k) > 64 or not ID_RE.match(k):
            fail("%s: invalid entry key %r" % (path, k))

def op_read(typ, path, maybe):
    try:
        fd, pfd, base, ap = open_final(path, os.O_RDONLY | os.O_NONBLOCK)
    except OSError as e:
        if maybe and e.errno == errno.ENOENT:
            sys.exit(3)
        if typ == "scenes" and e.errno == errno.ENOENT:
            fail("not found: %s - run: omarchy-scene init" % path)
        fail("cannot open %s: %s" % (path, e.strerror or e))
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode):
            fail("refusing non-regular file (symlink/FIFO/device): %s" % path)
        if st.st_uid != os.geteuid():
            fail("refusing file not owned by current user: %s" % path)
        if st.st_size > MAX_BYTES:
            fail("refusing oversized file: %s (%d bytes > %d)" % (path, st.st_size, MAX_BYTES))
        data = b""
        while True:
            try:
                chunk = os.read(fd, 1 << 20)
            except BlockingIOError:
                continue
            if not chunk:
                break
            data += chunk
            if len(data) > MAX_BYTES:
                fail("refusing oversized file: %s (%d bytes > %d)" % (path, len(data), MAX_BYTES))
        doc = None
        if typ in ("json", "scenes", "entries"):
            doc = parse_checked(data, path)
            if typ == "scenes":
                check_scenes(doc, path)
            elif typ == "entries":
                check_entries(doc, path)
        sys.stdout.buffer.write(data)
        sys.stdout.buffer.flush()
    finally:
        os.close(fd)
        os.close(pfd)

def read_write_input():
    """写内容来源: 脚本内经 fd 3（fd 0 被解释器脚本占据）；直连调用时回退到 fd 0。"""
    for fd in (3, 0):
        try:
            return os.fdopen(fd, "rb", closefd=True).read(MAX_WRITE + 1)
        except OSError:
            continue
    fail("cannot read write input")

def op_write(path):
    data = read_write_input()
    if len(data) > MAX_WRITE:
        fail("refusing oversized write: %s" % path)
    pfd, base, ap = resolve_parent(path)
    mode = None
    tmpfd = None
    tmpname = None
    try:
        # 目标模式: 若已存在则必须是归我们所有的常规文件（不跟随符号链接）
        try:
            tfd = os.open(base, os.O_RDONLY | os.O_NONBLOCK | os.O_NOFOLLOW | os.O_CLOEXEC, dir_fd=pfd)
            try:
                st = os.fstat(tfd)
                if not stat.S_ISREG(st.st_mode):
                    fail("refusing non-regular target: %s" % path)
                if st.st_uid != os.geteuid():
                    fail("refusing target not owned by current user: %s" % path)
                mode = stat.S_IMODE(st.st_mode)
            finally:
                os.close(tfd)
        except OSError as e:
            if e.errno != errno.ENOENT:
                fail("cannot open target %s: %s" % (path, e.strerror or e))
        if mode is None:
            mode = 0o600
        # 同目录随机临时文件（O_EXCL，无碰撞、不可预测）
        for _ in range(32):
            cand = ".omarchy-scene.%s.tmp" % secrets.token_hex(8)
            try:
                tmpfd = os.open(cand, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600, dir_fd=pfd)
                tmpname = cand
                break
            except FileExistsError:
                continue
        if tmpname is None:
            fail("cannot create temp file in %s" % os.path.dirname(ap))
        # 描述符全程打开: create -> write -> validate -> chmod -> fsync -> atomic publish
        off = 0
        while off < len(data):
            n = os.write(tmpfd, data[off:])
            if n <= 0:
                raise OSError(errno.EIO, "short write")
            off += n
        st = os.fstat(tmpfd)
        if not stat.S_ISREG(st.st_mode) or st.st_size != len(data):
            fail("temp file validation failed for %s" % path)
        os.fchmod(tmpfd, mode)
        os.fsync(tmpfd)
        os.rename(tmpname, base, src_dir_fd=pfd, dst_dir_fd=pfd)   # 原子发布
    finally:
        try:
            os.fsync(pfd)
        except OSError:
            pass
        if tmpfd is not None:
            try:
                os.close(tmpfd)
            except OSError:
                pass
        if tmpname is not None:
            try:
                os.unlink(tmpname, dir_fd=pfd)
            except OSError:
                pass
        os.close(pfd)

def prune_backups(pfd, base, ap, keep):
    """同目录自清理: 只保留本工具创建的、最近 keep 份 <base>.bak.* 备份。
       命名规则（新旧格式都覆盖）:
         .<base>.bak.<ts>.<rand>     （描述符安全 I/O 格式）
         <base>.bak.scene.<ts>       （旧版 set 备份格式，无前导点）
         <base>.bak.<ts>             （最早 init 备份格式）
       其他工具的同目录文件（如 shell.json.bak.opencode.*）一律不碰。"""
    if keep < 1:
        keep = 1
    pat = re.compile(r"^\.?" + re.escape(base) + r"\.bak\.(?:(?:scene)\.)?\d+(?:\.\w+)?$")
    try:
        names = os.listdir(pfd)
    except OSError:
        return
    cands = []
    for name in names:
        if not pat.match(name):
            continue
        try:
            st = os.stat(name, dir_fd=pfd)
            cands.append((st.st_mtime, name))
        except OSError:
            continue
    if len(cands) <= keep:
        return
    cands.sort(key=lambda t: t[0], reverse=True)   # 新的在前
    for _mt, name in cands[keep:]:
        try:
            os.unlink(name, dir_fd=pfd)             # unlinkat(父目录fd, 名字) —— 不跟随任何链接
        except OSError:
            pass

def op_backup(path, keep):
    try:
        srcfd, pfd, base, ap = open_final(path, os.O_RDONLY | os.O_NONBLOCK)
    except OSError as e:
        fail("cannot open %s: %s" % (path, e.strerror or e))
    tmpname = None
    tmpfd = None
    try:
        st = os.fstat(srcfd)
        if not stat.S_ISREG(st.st_mode):
            fail("refusing non-regular backup source: %s" % path)
        if st.st_uid != os.geteuid():
            fail("refusing backup source not owned by current user: %s" % path)
        if st.st_size > MAX_BYTES:
            fail("refusing oversized backup source: %s (%d bytes)" % (path, st.st_size))
        ts = int(time.time())
        for _ in range(32):
            cand = ".%s.bak.%d.%s" % (base, ts, secrets.token_hex(6))
            try:
                tmpfd = os.open(cand, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC, stat.S_IMODE(st.st_mode), dir_fd=pfd)
                tmpname = cand
                break
            except FileExistsError:
                continue
        if tmpname is None:
            fail("cannot create backup in %s" % os.path.dirname(ap))
        # 描述符到描述符复制（备份源也是校验过的常规文件）
        total = 0
        while True:
            try:
                chunk = os.read(srcfd, 1 << 20)
            except BlockingIOError:
                continue
            if not chunk:
                break
            off = 0
            while off < len(chunk):
                n = os.write(tmpfd, chunk[off:])
                if n <= 0:
                    raise OSError(errno.EIO, "short write")
                off += n
            total += len(chunk)
        if total != st.st_size:
            fail("backup source changed while copying: %s" % path)
        os.fsync(tmpfd)
        prune_backups(pfd, base, ap, keep)
        sys.stdout.write(os.path.join(os.path.dirname(ap), tmpname) + "\n")
        sys.stdout.flush()
    finally:
        if tmpfd is not None:
            try:
                os.close(tmpfd)
            except OSError:
                pass
        os.close(srcfd)
        os.close(pfd)

def op_lock(lockpath, statuspath):
    try:
        fd, pfd, base, ap = open_final(lockpath, os.O_RDWR | os.O_CREAT, 0o600)
    except OSError as e:
        fail("cannot open lock file %s: %s" % (lockpath, e.strerror or e))
    os.close(pfd)
    # 与其他读写路径等价的保护: 锁文件必须是本人所有的常规文件（O_NOFOLLOW 已挡住符号链接，
    # 这里再挡住 FIFO/设备等非常规文件，避免被静默接受为锁对象）
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode):
            fail("refusing non-regular lock file (symlink/FIFO/device): %s" % lockpath)
        if st.st_uid != os.geteuid():
            fail("refusing lock file not owned by current user: %s" % lockpath)
    except SystemExit:
        os.close(fd)
        raise
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        fail("another omarchy-scene operation is running")
    # 父进程退出时自动释放锁（即使被 SIGKILL）
    try:
        libc = ctypes.CDLL(None, use_errno=True)
        libc.prctl(1, signal.SIGTERM)   # PR_SET_PDEATHSIG
    except Exception:
        pass
    # 握手状态文件（O_EXCL + 原子 rename 创建，供 bash 侧轮询）
    try:
        spfd, sbase, sap = resolve_parent(statuspath)
    except SystemExit:
        os.close(fd)
        raise
    sfd = None
    sname = None
    try:
        for _ in range(16):
            cand = ".%s.%s" % (sbase, secrets.token_hex(4))
            try:
                sfd = os.open(cand, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600, dir_fd=spfd)
                sname = cand
                break
            except FileExistsError:
                continue
        if sname is not None:
            os.write(sfd, b"ok")
            os.rename(sname, sbase, src_dir_fd=spfd, dst_dir_fd=spfd)
            sname = None
    except OSError:
        pass
    finally:
        if sfd is not None:
            try:
                os.close(sfd)
            except OSError:
                pass
        if sname is not None:
            try:
                os.unlink(sname, dir_fd=spfd)
            except OSError:
                pass
        os.close(spfd)
    # 持有锁直到被 SIGTERM 终止
    while True:
        time.sleep(3600)

def main(argv):
    op = argv[0]
    if op == "read":
        op_read(argv[1], argv[2], False)
    elif op == "read-maybe":
        op_read(argv[1], argv[2], True)
    elif op == "write":
        op_write(argv[1])
    elif op == "backup":
        op_backup(argv[1], int(argv[2]) if len(argv) > 2 else 10)
    elif op == "lock":
        op_lock(argv[1], argv[2])
    else:
        fail("unknown io op: %s" % op)

try:
    main(sys.argv[1:])
except SystemExit:
    raise
except Exception as e:
    fail("internal error (%s): %s" % (type(e).__name__, e))
OMARCHY_SCENE_PY_IO
}

# 读取: 描述符绑定一次打开 + 校验，内容（<=8MiB 常规文件、本人所有、结构受限）输出到 stdout。
# 所有 jq/awk/grep/sed 后续都只消费这里的捕获内容（stdin/变量），绝不再按路径重开文件。
#   secure_io read raw <path>      任意文本（JSONC/脚本自身）
#   safe_read_json <path>          通用 JSON（shell.json / ui-state.json）
#   read_scenes <path>             scenes.json（含所有场景专属限制）
#   read_entries <path>            entries.json
safe_read_json()  { secure_io read json "${1:?}"; }
read_scenes()     { secure_io read scenes "${1:?}"; }
read_entries()    { secure_io read entries "${1:?}"; }

# 原子写: 内容经 stdin 传入 -> 同目录 O_EXCL 随机临时文件 -> 描述符写/fchmod/fsync -> 原子 rename
write_atomic() { secure_io write "${1:?}"; }

# 备份: 描述符到描述符复制到同目录随机名（时间戳+随机后缀），输出新备份路径。
# 每次备份后同目录自清理: 只保留最近 $OMARCHY_SCENES_BACKUPS（默认 10）份本工具自己的备份。
secure_backup() { secure_io backup "${1:?}" "${OMARCHY_SCENES_BACKUPS:-10}"; }

# 并发互斥: O_NOFOLLOW 打开锁文件 + flock(EX|NB)；持有进程随本命令退出自动释放
LOCK_PID=""
acquire_lock() {
  ensure_config_dir
  local lockf="$CONFIG_DIR/.scenes.lock"
  local st="$CONFIG_DIR/.scenes.lock.status.$$"
  rm -f "$st" 2>/dev/null || true
  secure_io lock "$lockf" "$st" &
  LOCK_PID=$!
  local i=0
  while [[ ! -f "$st" ]] && kill -0 "$LOCK_PID" 2>/dev/null; do
    i=$((i + 1))
    [[ $i -gt 400 ]] && break
    sleep 0.01
  done
  if [[ ! -f "$st" ]]; then
    kill "$LOCK_PID" 2>/dev/null || true
    LOCK_PID=""
    die "another omarchy-scene operation is running (lock: $lockf)"
  fi
  rm -f "$st" 2>/dev/null || true
}

release_lock() {
  if [[ -n "${LOCK_PID:-}" ]]; then
    kill "$LOCK_PID" 2>/dev/null || true
    LOCK_PID=""
  fi
}
trap 'release_lock' EXIT

# ---------------------------------------------------------------- 场景文档读取与结构校验

# 读取并校验 scenes.json（含全部结构上限），内容存入全局 SCENES_DOC；后续命令一律使用该快照
SCENES_DOC=""
require_scenes() {
  SCENES_DOC=$(read_scenes "$SCENES_FILE")
  [[ -n "$SCENES_DOC" ]] || die "not found: $SCENES_FILE — run: omarchy-scene init"
}

# 解析参数并读出: current / default 数组 / scenes 对象
scenes_meta() {
  jq -r '{current: (.current // "default"), default: (.default // []), scenes: (.scenes // {})}' <<<"$SCENES_DOC"
}

scene_exists() {  # $1 = scene name（"default" 视为有效集合名）
  [[ -n "$1" ]] || return 1
  [[ "$1" == "default" ]] && return 0
  jq -e --arg s "$1" '.scenes | has($s)' <<<"$SCENES_DOC" >/dev/null 2>&1
}

plugin_in_catalog() {  # $1 = plugin id
  omarchy plugin list --json 2>/dev/null | jq -e --arg id "$1" 'any(.[]; .id == $id)' >/dev/null 2>&1
}

catalog_kinds() {  # $1 = id -> 逗号分隔 kinds（用于提示，非关键路径）
  omarchy plugin list --json 2>/dev/null | jq -r --arg id "$1" '.[] | select(.id == $id) | (.kinds | join(","))'
}

reload_shell() {
  # 写 shell.json 会触发热重载；这里再兜底一次，保证配置被应用
  eval "$SHELL_RELOAD_CMD" 2>/dev/null || true
}

notify() {  # $1 = 标题 $2 = 正文
  command -v notify-send >/dev/null 2>&1 && notify-send -a "omarchy-scene" -i "view-grid-symbolic" "$1" "$2" 2>/dev/null || true
}

# 从 shell.json 快照一批插件（$@=ids）到 entries.json（合并更新，保留已有）
# 快照内容: bar-widget -> {section, entry}; service/panel/overlay -> {entry}; bar -> {bar:true}
snapshot_entries() {
  [[ $# -eq 0 ]] && return 0
  local ids_json new_snap shell_doc entries_doc rc
  ids_json=$(printf '%s\n' "$@" | jq -R . | jq -s .)
  shell_doc=$(safe_read_json "$SHELL_JSON")
  new_snap=$(jq -n \
    --argjson shell "$shell_doc" \
    --argjson ids "$ids_json" '
      def widget_loc($id):
        (["left","center","right"] | map(.
          | select(([$shell.bar.layout[.][].id // ""] | index($id)) != null)
          | { section: .,
              index: ([$shell.bar.layout[.][].id // ""] | index($id)),
              entry: ($shell.bar.layout[.] | map(select(.id == $id)) | first) }
        ) | first?);
      [ ($ids[]) as $id |
        {
          id: $id,
          snap: (
            (widget_loc($id)) as $loc |
            (([$shell.plugins[] | select(.id == $id)] | first?)) as $p |
            if $loc then $loc
            elif $p then { entry: $p }
            elif ($shell.bar.id // "") == $id then { bar: true }
            else {} end
          )
        } | select(.snap != {}) ] | map({(.id): .snap}) | add
    ')
  [[ -z "$new_snap" || "$new_snap" == "null" ]] && return 0
  ensure_config_dir
  if entries_doc=$(secure_io read-maybe entries "$ENTRIES_FILE" 2>/dev/null); then
    jq -n --argjson cur "$entries_doc" --argjson snap "$new_snap" '$cur * $snap' | write_atomic "$ENTRIES_FILE"
  else
    rc=$?
    [[ $rc -eq 3 ]] || die "cannot read $ENTRIES_FILE"
    printf '%s\n' "$new_snap" | write_atomic "$ENTRIES_FILE"
  fi
}

# 计算受管集合: default ∪ 所有场景里的插件（去重、保持顺序）
managed_ids() {
  jq -r '
    ([.default // []] + [.scenes[]?.plugins // []] + [.locked // []]) | add | unique
  ' <<<"$SCENES_DOC"
}

# 计算目标集合: 非 default 场景 = default 集（继承）∪ 锁定插件（继承）∪ 该场景自己的插件；default = 仅默认集
target_ids() {  # $1 = scene
  if [[ "$1" == "default" ]]; then
    jq -r '[.default // []] | add | unique' <<<"$SCENES_DOC"
  else
    jq -r --arg s "$1" '
      ([.default // []] + [.locked // []] + [.scenes[$s].plugins // []]) | add | unique
    ' <<<"$SCENES_DOC"
  fi
}

# ---------------------------------------------------------------- transform

# 核心 jq 转换：把 shell.json 变成目标状态
read -r -d '' TRANSFORM <<'JQ' || true
  def ensure_shape:
    .bar = (.bar // {})
    | .bar.layout = (.bar.layout // {})
    | (.bar.layout.left //= [])
    | (.bar.layout.center //= [])
    | (.bar.layout.right //= [])
    | .plugins = (.plugins // []);

  def in_target($id): ($targets | index($id)) != null;
  def is_bar_opt($id): (($catalog[$id].kinds // []) | index("bar")) != null;
  def is_widget($id): (($catalog[$id].kinds // []) | index("bar-widget")) != null;
  def is_fp($id): ($catalog[$id].firstParty // false) == true;
  def widget_present($id): ([.bar.layout[] | .[] | .id // ""] | index($id)) != null;
  def plugin_present($id): ([.plugins[].id // ""] | index($id)) != null;

  def remove_layout($id):
    .bar.layout = (.bar.layout | with_entries(.value |= map(select((.id // "") != $id))));
  def remove_plugins($id):
    .plugins |= map(select((.id // "") != $id));
  def remove_disabled($id):
    if (.disabledPlugins? | type) == "array"
      then .disabledPlugins |= map(select(. != $id))
      else . end;
  def add_disabled($id):
    if ((.disabledPlugins? // []) | index($id)) == null
      then .disabledPlugins = ((.disabledPlugins? // []) + [$id])
      else . end;
  def clean_disabled:
    if (.disabledPlugins? | type) == "array" and (.disabledPlugins | length) == 0
      then del(.disabledPlugins)
      else . end;

  def insert_widget($id):
    if widget_present($id) then . else
      ($cache[$id]) as $c
      | if ($c.entry? != null)
          then
            ($c.section // "right") as $s
            | ($c.index // -1) as $i
            | .bar.layout[$s] |= (
                if $i < 0 then . + [$c.entry]
                else (([$i, length] | min)) as $at | .[0:$at] + [$c.entry] + .[$at:]
                end)
          else .bar.layout.right += [{id: $id}]
        end
    end;

  def insert_plugin($id):
    if plugin_present($id) then . else
      ($cache[$id]) as $c
      | if ($c.entry? != null)
          then .plugins += [$c.entry]
          else .plugins += [{id: $id}]
        end
    end;

  ensure_shape
  | reduce ($managed[]) as $id (.;
      if in_target($id) then
        if is_bar_opt($id) then .bar.id = $id
        elif is_widget($id) then insert_widget($id) | remove_disabled($id)
        else insert_plugin($id) | remove_disabled($id)
        end
      else
        if is_bar_opt($id) then
          if ((.bar.id // "") == $id) then del(.bar.id) else . end
        elif is_widget($id) then remove_layout($id)
        else remove_plugins($id) | if is_fp($id) then add_disabled($id) else . end
        end
      end
    )
  | clean_disabled
JQ

# 计算“启用状态”视图: id -> true/false，用于 diff 报告
# $1 = catalog JSON；shell 文档经 stdin 传入（已校验内容，非路径）
enabled_map() {
  jq -r --argjson catalog "$1" '
    def is_disabled($id): (.disabledPlugins? | index($id)) != null;
    def in_layout($id): ([.bar.layout[] | .[] | .id // ""] | index($id)) != null;
    def in_plugins($id): ([.plugins[].id // ""] | index($id)) != null;
    ($catalog | keys)[] as $id |
    (($catalog[$id].kinds // []) | index("bar")) as $isbar |
    if $isbar then {($id): ((.bar.id // "") == $id)}
    elif (is_disabled($id)) then {($id): false}
    elif ($catalog[$id].firstParty) then {($id): true}
    else {($id): (in_layout($id) or in_plugins($id))}
    end
  ' | jq -s add
}

# ---------------------------------------------------------------- commands

cmd_help() {
  secure_io read raw "$0" | sed -n '2,/^# Config:/p' | sed '$d' | sed 's/^# \{0,1\}//'
}

cmd_init() {
  local force=0
  [[ ${1:-} == "--force" ]] && force=1
  if [[ -f "$SCENES_FILE" && $force -eq 0 ]]; then
    die "$SCENES_FILE already exists (use --force to overwrite; the old file is backed up)"
  fi
  ensure_config_dir
  acquire_lock
  [[ -f "$SCENES_FILE" ]] && secure_backup "$SCENES_FILE" >/dev/null

  local ids ids_json default_json shell_doc init_layout catalog
  shell_doc=$(safe_read_json "$SHELL_JSON")
  ids=$(jq -r '[.bar.layout.left[], .bar.layout.center[], .bar.layout.right[], .plugins[]] | map(.id) | unique | .[]' <<<"$shell_doc")
  [[ -n "$ids" ]] || die "no manageable plugin entries in shell.json"

  # 快照这些插件的完整条目
  snapshot_entries $ids

  ids_json=$(printf '%s\n' "$ids" | jq -R . | jq -s .)
  # default 只收非 firstParty（内置）插件：内置跟随系统状态、不受场景切换管理。
  # 若把内置抄进 default，它们会变成“受管”，首次切换到新场景时 system-default
  # 的内置部件（tray/clock/menu/…）会被移出 bar 并禁用——新装继承 bug 的根源。
  catalog=$(omarchy plugin list --json 2>/dev/null) || catalog="[]"
  default_json=$(jq -n --argjson ids "$ids_json" --argjson cat "$catalog" '
    def is_fp($id): ((($cat | map(select(.id == $id))[0]) // {}).firstParty // false) == true;
    [ $ids[] | select(is_fp(.) | not) ]
  ')
  init_layout=$(jq -c '.bar.layout // {left: [], center: [], right: []}' <<<"$shell_doc")

  jq -n --argjson default "$default_json" --argjson layout "$init_layout" '
    {
      version: 1,
      current: "default",
      _comment: "omarchy-scene scene config. default is the base set: its plugins stay enabled in every scene (inherited), and every scene runs default + locked (inherited, always on) + its own plugins. Plugins in no scene are unmanaged and never touched; omarchy built-ins follow the system state and are locked by default (unlock them via unlockedBuiltins to manage manually). Manage with omarchy-scene add/add-plugin/rm/rm-plugin/toggle-plugin/lock/unlock, or edit this file directly.",
      default: $default,
      locked: [],
      unlockedBuiltins: [],
      scenes: {},
      _layouts: { default: $layout }
    }
  ' | write_atomic "$SCENES_FILE"
  regenerate_ui_state

  echo "initialized $SCENES_FILE"
  echo "  default base set (user plugins): $(echo "$default_json" | jq -r '.[]' | tr '\n' ' ')"
  echo "Next: omarchy-scene add <name> --label <label>  # create a scene, then omarchy-scene add-plugin <scene> <plugin-id>"
  echo "      omarchy-scene list      # view"
}

cmd_list() {
  require_scenes
  local meta current
  meta=$(scenes_meta)
  current=$(jq -r '.current' <<<"$meta")
  local catalog
  catalog=$(omarchy plugin list --json 2>/dev/null | jq 'map({(.id): {kinds: .kinds, firstParty: .firstParty}}) | add')
  local em
  em=$(enabled_map "$catalog" <<<"$(safe_read_json "$SHELL_JSON")")

  echo "Current scene: $current"
  echo
  echo "default scene (base set, inherited by every scene):"
  jq -r '.default[]' <<<"$SCENES_DOC" | while read -r id; do
    local st; st=$(jq -r --arg id "$id" '.[$id] // false' <<<"$em")
    printf '  %s %s\n' "$([[ $st == true ]] && echo '✓' || echo '·')" "$id"
  done
  echo
  jq -r '.scenes | to_entries[] | [.key, (.value.label // .key), (.value.plugins // [] | join(" "))] | @tsv' <<<"$SCENES_DOC" | while IFS=$'\t' read -r name label rest; do
    echo "Scene $name ($label):"
    [[ -z "$rest" ]] && echo "  (no dedicated plugins)"
    for id in $rest; do
      local st; st=$(jq -r --arg id "$id" '.[$id] // false' <<<"$em")
      printf '  %s %s\n' "$([[ $st == true ]] && echo '✓' || echo '·')" "$id"
    done
  done
  echo
  echo "Hint: omarchy-scene set <scene> to switch; omarchy-scene menu-add to generate the bar menu"
}

cmd_current() { require_scenes; jq -r '.current // "default"' <<<"$SCENES_DOC"; }

# 计算切换 diff（只读，打印 to_enable/to_disable；dry-run 与写入前预览共用），
# 结果写入全局 DIFF_* 供 activate_scene 发布。依赖 SCENES_DOC；调用方需已 require_scenes。
DIFF_SHELL="" DIFF_CUR_SCENE="" DIFF_CUR_LAYOUT=""
set_diff() {  # $1 = scene；$2 = quiet（不打印）
  local scene="$1" quiet="${2:-}"
  local managed targets catalog shell_doc new_shell before after to_enable to_disable
  managed=$(managed_ids)
  targets=$(target_ids "$scene")
  # managed / targets 本身就是合法 JSON 数组（jq 输出），直接作为 --argjson 传入
  catalog=$(omarchy plugin list --json 2>/dev/null | jq 'map({(.id): {kinds: .kinds, firstParty: .firstParty}}) | add')

  # 记录“离开前”场景的完整布局快照（含未受管内置部件如 wifi/ai/audio）；
  # 下一次再进入该场景时用它精确还原，避免按缓存索引增量插入造成的部件漂移。
  shell_doc=$(safe_read_json "$SHELL_JSON")
  local cur_scene cur_layout cached_layout seeded_shell
  cur_scene=$(jq -r '.current // "default"' <<<"$SCENES_DOC")
  cur_layout=$(jq -c '.bar.layout // {left: [], center: [], right: []}' <<<"$shell_doc")
  # 若目标场景已有布局快照，则以其为起始布局再跑 transform（快照里的受管部件已就位，
  # insert_widget 全部 no-op，未受管内置部件保持在快照位置，成员关系仍由 transform 强制）。
  # 但快照可能早于用户后来手动启用/安装的部件——因此先把当前 bar 里“未受管、目录已知、
  # 且快照缺失”的部件合并回快照（保留其在当前 bar 的位置），绝不因陈旧快照把后来启用的
  # 部件（如 tailscale）从 bar 刷掉。目录未知的幽灵部件（如 io.omarchy.share）不会被合并进
  # 目标场景，避免把上一个场景的残留部件带进下一个场景。受管部件去留仍由 transform 决定。
  cached_layout=$(jq -r --arg s "$scene" '._layouts[$s] // null' <<<"$SCENES_DOC")
  if [[ "$cached_layout" != "null" && -n "$cached_layout" ]]; then
    merged_layout=$(jq -n \
      --argjson cached "$cached_layout" \
      --argjson live "$shell_doc" \
      --argjson managed "$managed" \
      --argjson catalog "$catalog" '
        def unmanaged($id): ($managed | index($id)) == null;
        def known($id): ($catalog | has($id)) == true;
        def present($lay; $id): ([($lay[] | .id // "")] | index($id)) != null;
        def merge_section($s):
          reduce (($live.bar.layout[$s] // []) | to_entries[]) as $e (.;
            if ((($e.value.id // "") != "")
                and unmanaged($e.value.id)
                and known($e.value.id)
                and (present(.[$s]; $e.value.id) | not))
            then .[$s] |= (([$e.key, length] | min) as $at | .[0:$at] + [$e.value] + .[$at:])
            else . end);
        { left: ($cached.left // []), center: ($cached.center // []), right: ($cached.right // []) }
        | merge_section("left") | merge_section("center") | merge_section("right")
      ')
    seeded_shell=$(jq --argjson lay "$merged_layout" '.bar.layout = $lay' <<<"$shell_doc")
  else
    seeded_shell="$shell_doc"
  fi
  before=$(enabled_map "$catalog" <<<"$shell_doc")
  local cache_doc
  cache_doc=$(secure_io read-maybe entries "$ENTRIES_FILE" 2>/dev/null) || cache_doc="{}"
  new_shell=$(jq -r "$TRANSFORM" \
    --argjson targets "$targets" \
    --argjson managed "$managed" \
    --argjson cache "$cache_doc" \
    --argjson catalog "$catalog" \
    <<<"$seeded_shell")
  after=$(enabled_map "$catalog" <<<"$new_shell")

  if [[ -z "$quiet" ]]; then
    to_enable=$(jq -nr --argjson a "$before" --argjson b "$after" '
      ($b | to_entries | map(select(.value == true))) as $ben |
      ($a | to_entries | map(select(.value == true))) as $aen |
      ([$ben[].key] - [$aen[].key]) | .[]
    ' | grep -v '^$' || true)
    to_disable=$(jq -nr --argjson a "$before" --argjson b "$after" '
      ($a | to_entries | map(select(.value == true))) as $aen |
      ($b | to_entries | map(select(.value == true))) as $ben |
      ([$aen[].key] - [$ben[].key]) | .[]
    ' | grep -v '^$' || true)
    echo "Scene [$scene]:"
    [[ -n "$to_enable" ]] && for id in $to_enable; do echo "  + enable  $id"; done || true
    [[ -n "$to_disable" ]] && for id in $to_disable; do echo "  - disable  $id"; done || true
    [[ -z "$to_enable" && -z "$to_disable" ]] && echo "  (no change)"
  fi
  DIFF_SHELL="$new_shell"
  DIFF_CUR_SCENE="$cur_scene"
  DIFF_CUR_LAYOUT="$cur_layout"
}

# 核心切换：把 set_diff 算出的目标状态原子发布到 shell.json + 场景文档，并重载 shell。
# 调用方必须已持有独占锁（不重复 acquire_lock）；内部重读 scenes.json（动态场景）。
activate_scene() {  # $1 = scene
  local scene="$1"
  require_scenes
  scene_exists "$scene" || die "unknown scene: '$scene' (available: $(jq -r '.scenes | keys | join(", ")' <<<"$SCENES_DOC"))"
  # 先快照当前受管集合（保证切换后被关闭的插件位置/设置不丢）
  snapshot_entries $(jq -r '.[]' <<<"$(managed_ids)")
  set_diff "$scene" quiet
  # 3) 校验生成结果（内容变量，非路径）-> 备份 -> 原子写
  jq -e . <<<"$DIFF_SHELL" >/dev/null || die "transform produced invalid JSON, write aborted"
  secure_backup "$SHELL_JSON" >/dev/null
  printf '%s\n' "$DIFF_SHELL" | write_atomic "$SHELL_JSON"
  # 4) 记录当前场景 + 离开前场景的布局快照 + 本次实际应用的布局（单次原子写）。
  #    同时刷新 _layouts[$scene] 为本次真正应用的布局，避免陈旧快照（缺失后来启用的
  #    未受管部件如 tailscale）在下次进入该场景时把部件刷掉；自切换（apply 到当前场景）时
  #    $c == $s，$newlay 后写覆盖，即本次应用态。
  local new_layout
  new_layout=$(jq -c '.bar.layout' <<<"$DIFF_SHELL")
  jq --arg c "$DIFF_CUR_SCENE" --arg s "$scene" --argjson lay "$DIFF_CUR_LAYOUT" --argjson newlay "$new_layout" \
    '.current = $s | ._layouts[$c] = $lay | ._layouts[$s] = $newlay' <<<"$SCENES_DOC" | write_atomic "$SCENES_FILE"
  regenerate_ui_state
  reload_shell
  notify "Scene switched" "$scene"
  echo "Switched to scene: $scene"
}

cmd_set() {  # $1 = scene, $2 = --dry-run
  local scene="${1:-}" dry=0
  [[ ${2:-} == "--dry-run" ]] && dry=1
  acquire_lock
  require_scenes
  scene_exists "$scene" || die "unknown scene: '$scene' (available: $(jq -r '.scenes | keys | join(", ")' <<<"$SCENES_DOC"))"
  set_diff "$scene"
  if [[ $dry -eq 1 ]]; then
    echo
    echo "(dry-run, nothing written; drop --dry-run to apply)"
    return 0
  fi
  activate_scene "$scene"
}

cmd_cycle() {
  require_scenes
  local dry=0
  [[ ${1:-} == "--dry-run" ]] && dry=1
  local current
  current=$(jq -r '.current // "default"' <<<"$SCENES_DOC")
  local names; names=$(jq -r '.scenes | keys | .[]' <<<"$SCENES_DOC")
  local list; list=$(printf '%s\n' "default"; printf '%s\n' "$names")
  [[ -n "$names" ]] || die "no scenes yet — run: omarchy-scene add <name>"
  local next
  # 在当前项之后取下一个；若当前不在列表（如旧状态）则取第一个
  next=$(awk -v c="$current" '{ if (found) { print; exit } if ($0==c) found=1 }' <<<"$list")
  [[ -z "$next" ]] && next=$(head -n1 <<<"$list")
  if [[ $dry -eq 1 ]]; then
    echo "current: $current -> next: $next (dry-run)"
    return 0
  fi
  cmd_set "$next"
}

cmd_add() {  # $1 = name, --label, --icon
  local name="${1:-}"
  local label="" icon=""
  [[ -n "$name" ]] || die "usage: omarchy-scene add <name> [--label <label>] [--icon <glyph>]"
  shift
  while (( $# > 0 )); do
    case "$1" in
      --label) label="${2:-}"; shift 2 ;;
      --icon) icon="${2:-}"; shift 2 ;;
      *) die "unknown argument: $1" ;;
    esac
  done
  acquire_lock
  require_scenes
  scene_exists "$name" && die "scene already exists: $name"
  [[ $name =~ ^[a-zA-Z0-9_-]+$ ]] || die "scene name may only contain letters/digits/-/_"
  [[ ${#name} -le $MAX_NAME_LEN ]] || die "scene name too long (max $MAX_NAME_LEN characters)"
  [[ -z "$label" ]] && label="$name"
  [[ ${#label} -le $MAX_LABEL_LEN ]] || die "scene label too long (max $MAX_LABEL_LEN characters)"
  [[ ${#icon} -le 4 ]] || die "scene icon too long (max 4 characters)"
  local n
  n=$(jq -r '.scenes | length' <<<"$SCENES_DOC")
  [[ $n -lt $MAX_SCENES ]] || die "maximum $MAX_SCENES custom scenes reached"
  if [[ -n "$icon" ]]; then
    jq --arg n "$name" --arg l "$label" --arg i "$icon" '.scenes[$n] = {label: $l, plugins: [], icon: $i}' <<<"$SCENES_DOC" | write_atomic "$SCENES_FILE"
  else
    jq --arg n "$name" --arg l "$label" '.scenes[$n] = {label: $l, plugins: []}' <<<"$SCENES_DOC" | write_atomic "$SCENES_FILE"
  fi
  regenerate_ui_state
  echo "created scene $name (label=$label). Add plugins: omarchy-scene add-plugin $name <plugin-id>"
}

cmd_rm() {
  local name="${1:-}"
  [[ -n "$name" ]] || die "Usage: omarchy-scene rm <name>"
  acquire_lock
  require_scenes
  scene_exists "$name" || die "unknown scene: $name"
  [[ "$(jq -r '.current' <<<"$SCENES_DOC")" == "$name" ]] && die "cannot delete the current scene (switch first: omarchy-scene set <other>)"
  jq --arg n "$name" 'del(.scenes[$n]) | del(._layouts[$n]?)' <<<"$SCENES_DOC" | write_atomic "$SCENES_FILE"
  regenerate_ui_state
  echo "deleted scene $name"
}

cmd_add_plugin() {  # $1 = scene, $2 = id（scene 可为 default）
  local scene="${1:-}" id="${2:-}"
  [[ -n "$scene" && -n "$id" ]] || die "Usage: omarchy-scene add-plugin <scene|default> <plugin-id>"
  acquire_lock
  require_scenes
  scene_exists "$scene" || die "unknown scene: $scene"
  plugin_in_catalog "$id" || die "unknown plugin: $id (see omarchy plugin list)"
  local kinds; kinds=$(catalog_kinds "$id")
  if [[ "$scene" == "default" ]]; then
    jq -e --arg i "$id" '(.default | index($i)) == null' <<<"$SCENES_DOC" >/dev/null \
      || die "plugin $id is already in default"
    jq --arg i "$id" '.default += [$i]' <<<"$SCENES_DOC" | write_atomic "$SCENES_FILE"
  else
    jq -e --arg s "$scene" --arg i "$id" '(.scenes[$s].plugins | index($i)) == null' <<<"$SCENES_DOC" >/dev/null \
      || die "plugin $id is already in scene $scene"
    jq --arg s "$scene" --arg i "$id" '.scenes[$s].plugins += [$i]' <<<"$SCENES_DOC" | write_atomic "$SCENES_FILE"
  fi
  # 快照条目（若当前启用）
  snapshot_entries "$id"
  regenerate_ui_state
  echo "added $id ($kinds) to $scene"
  echo "Hint: run omarchy-scene menu-add to refresh the bar menu"
}

cmd_rm_plugin() {  # $1 = scene, $2 = id（scene 可为 default）
  local scene="${1:-}" id="${2:-}"
  [[ -n "$scene" && -n "$id" ]] || die "Usage: omarchy-scene rm-plugin <scene|default> <plugin-id>"
  acquire_lock
  require_scenes
  scene_exists "$scene" || die "unknown scene: $scene"
  if [[ "$scene" == "default" ]]; then
    jq -e --arg i "$id" '(.default | index($i)) != null' <<<"$SCENES_DOC" >/dev/null \
      || die "plugin $id is not in default"
    jq --arg i "$id" '.default |= map(select(. != $i))' <<<"$SCENES_DOC" | write_atomic "$SCENES_FILE"
  else
    jq -e --arg s "$scene" --arg i "$id" '(.scenes[$s].plugins | index($i)) != null' <<<"$SCENES_DOC" >/dev/null \
      || die "plugin $id is not in scene $scene"
    jq --arg s "$scene" --arg i "$id" '.scenes[$s].plugins |= map(select(. != $i))' <<<"$SCENES_DOC" | write_atomic "$SCENES_FILE"
  fi
  regenerate_ui_state
  echo "removed $id from $scene"
}

cmd_reopen_done() {
  # 清除“刷新后重开配置页”标记：内容安全写回 "0"（保持文件存在，避免部件每次重建时
  # FileView 首读不存在的路径刷 ENOENT 告警）。写入仍走 secure_io——若标记被预置成
  # 符号链接/非常规文件，op_write 拒绝（绝不像 printf 那样沿链接截断任意目标），
  # 这里退化为 unlink 链接本身（不跟随、不截断），并提示用户修复。
  if ! printf '0' | write_atomic "$CONFIG_DIR/.reopen-config" 2>/dev/null; then
    rm -f -- "$CONFIG_DIR/.reopen-config"
    echo "omarchy-scene: warning: removed non-regular .reopen-config (symlink/FIFO/device); check the file" >&2
  fi
}

cmd_refresh() {
  local reopen=1
  [[ ${1:-} == "--no-reopen" ]] && reopen=0
  acquire_lock
  require_scenes
  if [[ $reopen -eq 1 ]]; then
    # 先落“刷新后重开配置页”标记：rescanPlugins 会重建 max.scene 部件（配置面板随部件销毁），
    # 重建后的 Scene.qml 读到该标记即自动重新打开配置面板；rescan 失败则不保留标记。
    # 标记写入经 secure_io（O_EXCL 同目录临时文件 + 描述符校验 + 原子 rename）。若目标已被预置成
    # 符号链接/非常规文件，op_write 会拒绝（绝不像 printf '1' > 那样沿链接截断任意目标），
    # 这里随即 unlink 该链接并报错终止——安全失败，而不是悄悄放过。
    if ! printf '1' | write_atomic "$CONFIG_DIR/.reopen-config"; then
      rm -f -- "$CONFIG_DIR/.reopen-config"
      die "cannot write reopen marker: refusing non-regular .reopen-config (symlink/FIFO/device); removed it"
    fi
  else
    # 切换弹层的“refresh plugin cache”按钮走这里：只刷缓存、不弹配置面板。
    # 关键：除了不写 “1”，还要把标记写回 “0”——清掉任何遗留的 “1”（例如此前配置页刷新
    # 留下的），否则重建后的部件仍会读到 “1” 而误弹配置面板。与 reopen-done 同一条安全路径：
    # 常规文件写 “0”；符号链接/非常规标记只 unlink 链接本身（不跟随、不截断），此处尽力而为不报错。
    if ! printf '0' | write_atomic "$CONFIG_DIR/.reopen-config" 2>/dev/null; then
      rm -f -- "$CONFIG_DIR/.reopen-config"
    fi
  fi
  # 让 shell 重新发现插件（新安装/克隆的插件要先 rescan 才进 catalog）
  if omarchy-shell -q shell rescanPlugins >/dev/null 2>&1; then
    :
  elif [[ $reopen -eq 1 ]]; then
    rm -f -- "$CONFIG_DIR/.reopen-config"
  fi
  local managed; managed=$(managed_ids)
  snapshot_entries $(jq -r '.[]' <<<"$managed")
  regenerate_ui_state
  echo "refreshed $(jq -r '.[]' <<<"$managed" | wc -l) managed plugin entry snapshots"
}

cmd_status() {
  require_scenes
  local current; current=$(jq -r '.current // "default"' <<<"$SCENES_DOC")
  local catalog
  catalog=$(omarchy plugin list --json 2>/dev/null | jq 'map({(.id): {kinds: .kinds, firstParty: .firstParty}}) | add')
  local em; em=$(enabled_map "$catalog" <<<"$(safe_read_json "$SHELL_JSON")")
  local targets; targets=$(target_ids "$current")
  local managed; managed=$(managed_ids)

  echo "Current scene: $current"
  echo "plugin                     state      target"
  echo "----------------------------------------"
  for id in $(jq -r '.[]' <<<"$managed"); do
    local st in_target
    st=$(jq -r --arg id "$id" '.[$id] // false' <<<"$em")
    if jq -e --arg id "$id" 'index($id) != null' <<<"$targets" >/dev/null; then in_target="on"; else in_target="off"; fi
    local mark="  "
    [[ "$st" == "$([[ $in_target == on ]] && echo true || echo false)" ]] && mark="OK" || mark="!!"
    printf '  %-24s %-5s %-5s %s\n' "$id" "$st" "$in_target" "$mark"
  done
  echo "(OK=matches target; !!=needs a switch to take effect)"
}

# 生成 Scenes 子菜单 JSONC 块（单行，两空格缩进；场景 key 已由 read_scenes 限制 <=10 字符）
menu_block() {
  jq -r '
    [["scenes", {icon: "󰕮", label: "Scenes"}]] +
    [.scenes | to_entries[] |
      select(.key | test("^[a-zA-Z0-9_-]{1,10}$")) |
      ["scenes." + .key, {icon: ((.value.icon // "")[0:4]), label: ((.value.label // .key)[0:64]),
        checked: ("test \"$(omarchy-scene current 2>/dev/null)\" = '"'"'" + .key + "'"'"'"),
        action: ("omarchy-scene set '"'"'" + .key + "'"'"'")}]]
    | .[]
    | "\"" + .[0] + "\": " + (.[1] | tostring)
  ' <<<"$SCENES_DOC" | paste -sd, - | sed 's/^/  /'
}

# 计算注入 Scenes 子菜单后的完整菜单内容（输出到 stdout；不写文件）
# 所有对 MENU_FILE 的读取都来自已验证内容（menu_doc），awk/grep/sed 只消费 stdin/环境变量
menu_add_content() {
  local menu_doc block
  menu_doc=$(secure_io read raw "$MENU_FILE")
  block=$(menu_block)
  if grep -qF "$MENU_MARK_BEGIN" <<<"$menu_doc"; then
    BLOCK="$block" awk -v begin="$MENU_MARK_BEGIN" -v end="$MENU_MARK_END" '
      function dump() { n = split(ENVIRON["BLOCK"], lines, "\n"); for (i=1; i<=n; i++) print lines[i] }
      index($0, begin) { skip=1; print; dump(); next }
      index($0, end)   { skip=0; print; next }
      !skip { print }
    ' <<<"$menu_doc"
  else
    # 在最后一个 "}"（对象闭合）行之前插入；否则追加到末尾
    if grep -nq '^}' <<<"$menu_doc"; then
      local last prev add_comma
      last=$(grep -n '^}' <<<"$menu_doc" | tail -n1 | cut -d: -f1)
      # 前一行去掉注释后若不以 , 或 { 结尾，需要在插入点前补逗号才能保持合法 JSON
      prev=$(sed -n "$((last-1))p" <<<"$menu_doc" | sed -E 's|//.*$||' | sed -E 's|[[:space:]]+$||')
      add_comma=""
      if [[ -n "$prev" ]] && ! [[ "$prev" =~ [,\{]$ ]]; then
        add_comma=1
      fi
      sed -n "1,$((last-1))p" <<<"$menu_doc"
      [[ -n "$add_comma" ]] && printf '%s\n' "  ,"
      printf '%s\n' "$MENU_MARK_BEGIN"
      printf '%s\n' "$block"
      printf '%s\n' "$MENU_MARK_END"
      echo "}"
      sed -n "$((last+1)),\$p" <<<"$menu_doc"
    else
      printf '%s\n' "$menu_doc"
      printf '%s\n' "$MENU_MARK_BEGIN"
      printf '%s\n' "$block"
      printf '%s\n' "$MENU_MARK_END"
    fi
  fi
}

cmd_menu_add() {
  acquire_lock
  require_scenes
  [[ -e "$MENU_FILE" ]] || die "not found: $MENU_FILE"
  local content
  content=$(menu_add_content)
  # 校验注入后仍能解析为合法 JSON（去掉行注释后）；内容校验通过才经 write_atomic 原子发布
  if ! jq -e . <<<"$(printf '%s\n' "$content" | sed -E 's|//.*||')" >/dev/null 2>&1; then
    die "generated menu is not valid JSON, write aborted (check scenes.json or handle $MENU_FILE manually)"
  fi
  printf '%s\n' "$content" | write_atomic "$MENU_FILE"
  echo "wrote the Scenes submenu to $MENU_FILE (menu hot-reloads on save)"
  echo "Note: after adding/removing scenes/plugins, rerun omarchy-scene menu-add; or omarchy-scene menu-remove to remove it"
}

cmd_menu_remove() {
  acquire_lock
  local menu_doc
  menu_doc=$(secure_io read raw "$MENU_FILE")
  if grep -qF "$MENU_MARK_BEGIN" <<<"$menu_doc"; then
    awk -v begin="$MENU_MARK_BEGIN" -v end="$MENU_MARK_END" '
      function flush() { if (prev != "") print prev }
      index($0, begin) {
        # 清理 menu-add 为保持合法 JSON 而自动补的逗号行（仅当它是我们加的那一行）
        if (prev == "  ,") prev = ""
        skip = 1; next
      }
      index($0, end) { skip = 0; next }
      {
        if (!skip) { flush(); prev = $0 }
        else prev = ""
      }
      END { flush() }
    ' <<<"$menu_doc" | write_atomic "$MENU_FILE"
    echo "removed the Scenes submenu"
  else
    echo "no Scenes submenu marker found ($MENU_FILE)"
  fi
}

cmd_edit() {
  require_scenes
  local editor="${EDITOR:-nano}"
  command -v "$editor" >/dev/null 2>&1 || editor=nano
  "$editor" "$SCENES_FILE"
  # 编辑器退出后重读并校验：读路径仍走 descriptor 绑定 secure_io（拒绝符号链接/非常规文件、归用户所有、
  # <= 8MiB、结构上限），随后重生成 ui-state.json 供 QML 消费。用户手改的内容只有通过这层校验才会
  # 出现在界面上；JSON/结构破坏会在写入前中止（config_payload 失败 → 管道失败 → 不写 ui-state）。
  regenerate_ui_state
}

# bar 标签轮询用: 只输出当前场景名 + 显示名
cmd_bar_status() {
  require_scenes
  jq -c '
    (.current // "default") as $c |
    { current: $c,
      label: (if $c == "default" then "Default" else ((.scenes[$c].label // $c)) end) }
  ' <<<"$SCENES_DOC"
}

# 弹窗列表用: 输出全部场景（含 default）
cmd_scenes_json() {
  require_scenes
  jq -c '
    (.current // "default") as $c |
    (["default"] + (.scenes | keys)) as $names |
    { current: $c,
      currentLabel: (if $c == "default" then "Default" else ((.scenes[$c].label // $c)) end),
      scenes: (
        [ $names[] as $n |
          { name: $n,
            label: (if $n == "default" then "Default" else ((.scenes[$n].label // $n)) end),
            active: ($n == $c),
            count: (if $n == "default" then ((.default // []) | length)
                    else ((.scenes[$n].plugins // []) | length) end) }
        ]
      ) }
  ' <<<"$SCENES_DOC"
}

# 合并数据（插件目录 + scenes.json），供 UI 渲染；输出到 stdout。
# 在输出前强制目录派生字段上限（name<=128 / id<=64 / kinds<=16x32），失败即中止，绝不向 QML 输出超限数据。
config_payload() {
  local catalog out
  catalog=$(omarchy plugin list --json 2>/dev/null)
  [[ -z "$catalog" || "$catalog" == "null" ]] && catalog="[]"
  out=$(jq --argjson cat "$catalog" '
    def oklen($x; $n): (($x // "") | if type == "string" then (length <= $n) else false end);
    def okkinds($k): (($k // []) | if type == "array"
      then ((length <= 16) and all(.[]; if type == "string" then (length <= 32) else false end))
      else false end);
    (((($cat | type) == "array") and (($cat | length) <= 1024)
      and all($cat[]; . as $p | oklen($p.name; 128) and oklen($p.id; 64) and okkinds($p.kinds)))) as $catok |
    if ($catok | not) then error("catalog field limits exceeded (name<=128 id<=64 kinds<=16x32, count<=1024)")
    else
    (.default // []) as $def |
    (.scenes // {}) as $scn |
    (.locked // []) as $lock |
    (.unlockedBuiltins // []) as $unlocked |
    (.current // "default") as $c0 |
    (.defaultIcon // "") as $dIcon |
    ($cat | map(select(.firstParty == true) | .id)) as $fp |
    ($cat | map(select((.id // "") | type == "string" and test("^[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}$")))) as $catb |
    ($scn | keys | map(select(test("^[a-zA-Z0-9_-]{1,10}$")))) as $snames |
    ($c0 | select(test("^[a-zA-Z0-9_-]{1,10}$")) // "default") as $c |
    { current: $c,
      scenes: (
        (["default"] + $snames) | map(. as $n |
          { name: $n,
            icon: (if $n == "default" then ($dIcon[0:4]) else ((($scn[$n].icon) // "")[0:4]) end),
            label: (if $n == "default" then "Default" else ((($scn[$n].label // $n)[0:64])) end),
            active: ($n == $c),
            lockedCount: ($lock | length),
            count: (if $n == "default"
                    then ($def | map(select(. as $id | ($fp | index($id)) == null)) | length)
                    else (($scn[$n].plugins // []) | map(select(. as $id | ($fp | index($id)) == null)) | length) end) })
      ),
      plugins: (
        (($catb | map(select(.firstParty != true))) + ($catb | map(select(.firstParty == true))))
        | map(. as $pl |
          { id: $pl.id, name: $pl.name, kinds: $pl.kinds,
            enabled: ($pl.enabled == true),
            firstParty: ($pl.firstParty == true),
            locked: (if $pl.firstParty
                     then (($unlocked | index($pl.id)) == null)
                     else (($lock | index($pl.id)) != null) end),
            inDefault: (($def | index($pl.id)) != null),
            inScenes: (($scn | to_entries | map(select((.value.plugins // []) | index($pl.id) != null) | .key))) })
      ) }
    end
  ' <<<"$(read_scenes "$SCENES_FILE")") || die "payload generation failed (scene doc or catalog limits violated)"
  [[ -n "$out" ]] || die "payload generation produced no output"
  printf '%s' "$out"
}

cmd_config_json() { require_scenes; config_payload; echo; }

# 把合并数据写进 ui-state.json，供 bar 组件 FileView 监听实时刷新
regenerate_ui_state() {
  config_payload | write_atomic "$UI_STATE_FILE"
}

# 配置面板用：切换插件开关（on/off）——内部就是 omarchy plugin enable/disable，并同步场景清单
cmd_toggle_plugin() {  # $1 = scene, $2 = id, $3 = on|off
  local scene="${1:-}" id="${2:-}" state="${3:-}"
  [[ -n "$scene" && -n "$id" ]] || die "usage: omarchy-scene toggle-plugin <scene> <id> on|off"
  acquire_lock
  require_scenes
  scene_exists "$scene" || die "unknown scene: $scene"
  plugin_in_catalog "$id" || die "unknown plugin: $id（run omarchy plugin list）"
  [[ $state == "on" || $state == "off" ]] || die "state must be on or off"

  if [[ $state == "on" ]]; then
    local sec=""
    sec=$(secure_io read-maybe entries "$ENTRIES_FILE" 2>/dev/null | jq -r --arg i "$id" '.[$i].section // ""') || sec=""
    if [[ -n "$sec" ]]; then
      omarchy plugin enable "$id" --section "$sec" >/dev/null 2>&1 || die "omarchy plugin enable failed"
    else
      omarchy plugin enable "$id" >/dev/null 2>&1 || die "omarchy plugin enable failed"
    fi
    if [[ "$scene" == "default" ]]; then
      jq -e --arg i "$id" '(.default | index($i)) == null' <<<"$SCENES_DOC" >/dev/null 2>&1 \
        && jq --arg i "$id" '.default += [$i]' <<<"$SCENES_DOC" | write_atomic "$SCENES_FILE"
    else
      jq -e --arg s "$scene" --arg i "$id" '(.scenes[$s].plugins | index($i)) == null' <<<"$SCENES_DOC" >/dev/null 2>&1 \
        && jq --arg s "$scene" --arg i "$id" '.scenes[$s].plugins += [$i]' <<<"$SCENES_DOC" | write_atomic "$SCENES_FILE"
    fi
  else
    omarchy plugin disable "$id" >/dev/null 2>&1 || die "omarchy plugin disable failed"
    if [[ "$scene" == "default" ]]; then
      jq --arg i "$id" '.default |= map(select(. != $i))' <<<"$SCENES_DOC" | write_atomic "$SCENES_FILE"
    else
      jq --arg s "$scene" --arg i "$id" '.scenes[$s].plugins |= map(select(. != $i))' <<<"$SCENES_DOC" | write_atomic "$SCENES_FILE"
    fi
  fi
  # 同步插件位置缓存 + UI 状态文件
  snapshot_entries "$id"
  regenerate_ui_state
  echo "ok"
}

# 配置面板 Apply：把标记的开关批量落盘并切换到目标场景（一次事务、一次锁）。
# 用法: apply <scene> --on <id1,id2,...> --off <id3,...>（on/off 集合可省略）
cmd_apply() {
  local scene="${1:-}"; shift || true
  local on_ids="" off_ids=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --on) on_ids="${2:-}"; shift 2 ;;
      --off) off_ids="${2:-}"; shift 2 ;;
      *) die "usage: omarchy-scene apply <scene> --on <ids> --off <ids>" ;;
    esac
  done
  [[ -n "$scene" ]] || die "usage: omarchy-scene apply <scene> --on <ids> --off <ids>"
  acquire_lock
  require_scenes
  scene_exists "$scene" || die "unknown scene: $scene"

  local id sec
  # 校验全部 id（防注入；必须过插件 id 正则并在目录里）
  for id in ${on_ids//,/ } ${off_ids//,/ }; do
    [[ "$id" =~ ^[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}$ ]] || die "invalid plugin id: $id"
    plugin_in_catalog "$id" || die "unknown plugin: $id"
  done
  # 先快照变更条目（off 的条目缓存下来，未来 enable 时还原位置/设置）
  [[ -n "$on_ids$off_ids" ]] && snapshot_entries ${on_ids//,/ } ${off_ids//,/ }

  if [[ -n "$on_ids" ]]; then
    for id in ${on_ids//,/ }; do
      sec=""
      sec=$(secure_io read-maybe entries "$ENTRIES_FILE" 2>/dev/null | jq -r --arg i "$id" '.[$i].section // ""') || sec=""
      if [[ -n "$sec" ]]; then
        omarchy plugin enable "$id" --section "$sec" >/dev/null 2>&1 || die "omarchy plugin enable failed: $id"
      else
        omarchy plugin enable "$id" >/dev/null 2>&1 || die "omarchy plugin enable failed: $id"
      fi
      if [[ "$scene" == "default" ]]; then
        jq -e --arg i "$id" '(.default | index($i)) == null' <<<"$SCENES_DOC" >/dev/null 2>&1 \
          && jq --arg i "$id" '.default += [$i]' <<<"$SCENES_DOC" | write_atomic "$SCENES_FILE"
      else
        jq -e --arg s "$scene" --arg i "$id" '(.scenes[$s].plugins | index($i)) == null' <<<"$SCENES_DOC" >/dev/null 2>&1 \
          && jq --arg s "$scene" --arg i "$id" '.scenes[$s].plugins += [$i]' <<<"$SCENES_DOC" | write_atomic "$SCENES_FILE"
      fi
      SCENES_DOC=$(read_scenes "$SCENES_FILE")
    done
  fi

  if [[ -n "$off_ids" ]]; then
    for id in ${off_ids//,/ }; do
      omarchy plugin disable "$id" >/dev/null 2>&1 || die "omarchy plugin disable failed: $id"
      if [[ "$scene" == "default" ]]; then
        jq --arg i "$id" '.default |= map(select(. != $i))' <<<"$SCENES_DOC" | write_atomic "$SCENES_FILE"
      else
        jq --arg s "$scene" --arg i "$id" '.scenes[$s].plugins |= map(select(. != $i))' <<<"$SCENES_DOC" | write_atomic "$SCENES_FILE"
      fi
      SCENES_DOC=$(read_scenes "$SCENES_FILE")
    done
  fi

  [[ -z "$on_ids" && -z "$off_ids" ]] && echo "(no marks)"
  [[ -n "$on_ids" ]] && echo "applied on:  ${on_ids//,/ }"
  [[ -n "$off_ids" ]] && echo "applied off: ${off_ids//,/ }"
  activate_scene "$scene"
}

# 判断插件是否为 omarchy 内置（firstParty）
plugin_is_first_party() {  # $1 = plugin id
  omarchy plugin list --json 2>/dev/null | jq -r --arg id "$1" '.[] | select(.id == $id) | (.firstParty == true)' | grep -q true
}

# 锁定：把 default 场景里的插件加锁 → 所有场景都继承（始终启用）
# 内置插件：默认锁定（遵循系统默认状态；“锁” = 移出解锁清单）
cmd_lock() {  # $1 = id
  local id="${1:-}"
  [[ -n "$id" ]] || die "usage: omarchy-scene lock <plugin-id>"
  acquire_lock
  require_scenes
  plugin_in_catalog "$id" || die "unknown plugin: $id（run omarchy plugin list）"

  if plugin_is_first_party "$id"; then
    jq --arg i "$id" '.unlockedBuiltins = ((.unlockedBuiltins // []) | map(select(. != $i)))' <<<"$SCENES_DOC" | write_atomic "$SCENES_FILE"
    regenerate_ui_state
    echo "locked $id (omarchy built-in, follows system default)"
    return 0
  fi
  # 单次原子写完成两处变更（在内存中链式更新，避免读写不一致）
  local doc="$SCENES_DOC"
  if jq -e --arg i "$id" '(.default | index($i)) == null' <<<"$doc" >/dev/null 2>&1; then
    doc=$(jq --arg i "$id" '.default += [$i]' <<<"$doc") || die "scene transform failed"
  fi
  if jq -e --arg i "$id" '(.locked // [] | index($i)) == null' <<<"$doc" >/dev/null 2>&1; then
    doc=$(jq --arg i "$id" '.locked = ((.locked // []) + [$i])' <<<"$doc") || die "scene transform failed"
  fi
  printf '%s\n' "$doc" | write_atomic "$SCENES_FILE"
  regenerate_ui_state
  echo "locked $id (inherited by all scenes, always on)"
}

cmd_unlock() {  # $1 = id
  local id="${1:-}"
  [[ -n "$id" ]] || die "usage: omarchy-scene unlock <plugin-id>"
  acquire_lock
  require_scenes
  if plugin_is_first_party "$id"; then
    jq --arg i "$id" 'if ((.unlockedBuiltins // []) | index($i)) == null then .unlockedBuiltins += [$i] else . end' <<<"$SCENES_DOC" | write_atomic "$SCENES_FILE"
    regenerate_ui_state
    echo "unlocked $id (omarchy built-in — now manageable per scene)"
    return 0
  fi
  jq --arg i "$id" '.locked = ((.locked // []) | map(select(. != $i)))' <<<"$SCENES_DOC" | write_atomic "$SCENES_FILE"
  regenerate_ui_state
  echo "unlocked $id"
}

# 重命名场景 label
cmd_label() {  # $1 = scene, $2 = label
  local scene="${1:-}" label="${2:-}"
  [[ -n "$scene" && -n "$label" ]] || die "Usage: omarchy-scene label <scene> <label>"
  acquire_lock
  require_scenes
  if [[ "$scene" == "default" ]]; then
    die "the default scene display name is fixed to \"Default\""
  fi
  scene_exists "$scene" || die "unknown scene: $scene"
  [[ ${#label} -le $MAX_LABEL_LEN ]] || die "scene label too long (max $MAX_LABEL_LEN characters)"
  jq --arg s "$scene" --arg l "$label" '.scenes[$s].label = $l' <<<"$SCENES_DOC" | write_atomic "$SCENES_FILE"
  regenerate_ui_state
  echo "set scene $scene display name to $label"
}

# 设置/清除场景图标（顶栏显示；空 glyph = 清除）
cmd_icon() {  # $1 = scene, $2 = glyph
  local scene="${1:-}" glyph="${2:-}"
  [[ -n "$scene" ]] || die "usage: omarchy-scene icon <scene> <glyph-or-emoji> (empty glyph clears)"
  acquire_lock
  require_scenes
  scene_exists "$scene" || die "unknown scene: $scene"
  if [[ -n "$glyph" ]]; then
    [[ ${#glyph} -le 4 ]] || die "icon too long (max 4 characters)"
    if [[ "$scene" == "default" ]]; then
      jq --arg g "$glyph" '.defaultIcon = $g' <<<"$SCENES_DOC" | write_atomic "$SCENES_FILE"
    else
      jq --arg s "$scene" --arg g "$glyph" '.scenes[$s].icon = $g' <<<"$SCENES_DOC" | write_atomic "$SCENES_FILE"
    fi
  else
    if [[ "$scene" == "default" ]]; then
      jq 'del(.defaultIcon)' <<<"$SCENES_DOC" | write_atomic "$SCENES_FILE"
    else
      jq --arg s "$scene" 'del(.scenes[$s].icon)' <<<"$SCENES_DOC" | write_atomic "$SCENES_FILE"
    fi
  fi
  regenerate_ui_state
  echo "set scene $scene icon"
}

# 重命名场景（key + label）
cmd_rename() {  # $1 = old, $2 = new
  local old="${1:-}" new="${2:-}"
  [[ -n "$old" && -n "$new" ]] || die "usage: omarchy-scene rename <old> <new>"
  acquire_lock
  require_scenes
  scene_exists "$old" || die "unknown scene: $old"
  [[ "$old" == "default" ]] && die "cannot rename the default scene"
  [[ "$new" =~ ^[a-zA-Z0-9_-]+$ ]] || die "new scene name may only contain letters/digits/-/_"
  [[ ${#new} -le $MAX_NAME_LEN ]] || die "new scene name too long (max $MAX_NAME_LEN characters)"
  [[ "$new" != "$old" ]] || die "new name is the same"
  scene_exists "$new" && die "scene already exists: $new"
  jq --arg o "$old" --arg n "$new" '
    .scenes[$n] = .scenes[$o] |
    del(.scenes[$o]) |
    if (._layouts? != null) then ._layouts[$n] = ._layouts[$o] | del(._layouts[$o]) else . end |
    if .current == $o then .current = $n else . end
  ' <<<"$SCENES_DOC" | write_atomic "$SCENES_FILE"
  regenerate_ui_state
  # 刷新顶部栏菜单里的场景条目（复用同一把锁，不再重新加锁）
  if [[ -e "$MENU_FILE" ]]; then
    local mc
    mc=$(menu_add_content) || true
    if [[ -n "$mc" ]] && jq -e . <<<"$(printf '%s\n' "$mc" | sed -E 's|//.*||')" >/dev/null 2>&1; then
      printf '%s\n' "$mc" | write_atomic "$MENU_FILE"
    fi
  fi
  echo "renamed scene $old -> $new"
}

# ---------------------------------------------------------------- dispatch

cmd="${1:-}"
shift || true
case "$cmd" in
  help|-h|--help) cmd_help "$@" ;;
  init) cmd_init "$@" ;;
  list) cmd_list "$@" ;;
  current) cmd_current "$@" ;;
  set) cmd_set "$@" ;;
  apply) cmd_apply "$@" ;;
  cycle) cmd_cycle "$@" ;;
  add) cmd_add "$@" ;;
  rm) cmd_rm "$@" ;;
  add-plugin) cmd_add_plugin "$@" ;;
  rm-plugin) cmd_rm_plugin "$@" ;;
  refresh) cmd_refresh "$@" ;;
  status) cmd_status "$@" ;;  menu-add) cmd_menu_add "$@" ;;
  menu-remove) cmd_menu_remove "$@" ;;
  edit) cmd_edit "$@" ;;
  reopen-done) cmd_reopen_done "$@" ;;
  bar-status) cmd_bar_status "$@" ;;
  scenes) cmd_scenes_json "$@" ;;
  config) cmd_config_json "$@" ;;
  toggle-plugin) cmd_toggle_plugin "$@" ;;
  lock) cmd_lock "$@" ;;
  unlock) cmd_unlock "$@" ;;
  label) cmd_label "$@" ;;
  icon) cmd_icon "$@" ;;
  rename) cmd_rename "$@" ;;
  *) die "unknown command: $cmd (omarchy-scene help)" ;;
esac